[
  {
    "type": "heading",
    "defaultValue": "Doppler Configuration"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "toggle",
        "messageKey": "Autoplay",
        "label": "Autoplay radar",
        "defaultValue": true
      },
      {
        "type": "slider",
        "messageKey": "RadarInterval",
        "label": "Radar playback interval (ms)",
        "defaultValue": 500,
        "min": 200,
        "max": 1000,
        "step": 100
      },
      {
        "type": "select",
        "messageKey": "Palette",
        "label": "Radar color palette",
        "defaultValue": "darksky",
        "options": [
          {
            "label": "Dark Sky",
            "value": "darksky"
          },
          {
            "label": "NOAA NEXRAD",
            "value": "nexrad"
          }
        ],
        "capabilities": [
          "COLOR"
        ]
      },
      {
        "type": "select",
        "messageKey": "Dither",
        "label": "BW dither pattern",
        "description": "2x2 is crisper, 4x4 provides more 'shades of gray'",
        "defaultValue": "2x2",
        "options": [
          {
            "label": "2x2",
            "value": "2x2"
          },
          {
            "label": "4x4",
            "value": "4x4"
          }
        ],
        "capabilities": [
          "BW"
        ]
      },
      {
        "type": "slider",
        "messageKey": "PastFrames",
        "label": "Past frames",
        "description": "How many past (observed) radar frames to display.",
        "defaultValue": 12,
        "min": 1,
        "max": 12,
        "step": 1
      },
      {
        "type": "slider",
        "messageKey": "NowcastFrames",
        "label": "Nowcast frames",
        "description": "How many forecast radar frames to display.",
        "defaultValue": 6,
        "min": 0,
        "max": 6,
        "step": 1
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "select",
        "messageKey": "MapStyle",
        "label": "Map style",
        "description": "Simple recommended for BW watches and for map-on-top.",
        "defaultValue": "simple",
        "options": [
          {
            "label": "Simple",
            "value": "simple"
          },
          {
            "label": "Dithered",
            "value": "dither"
          }
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Location"
      },
      {
        "type": "select",
        "messageKey": "Location",
        "label": "Location",
        "defaultValue": "current",
        "options": [
          {
            "label": "Current",
            "value": "current"
          },
          {
            "label": "Custom",
            "value": "custom"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "CustomLat",
        "label": "Custom Latitude",
        "defaultValue": "",
        "description": "Decimal degrees, -90 to 90, e.g. 41.85",
        "attributes": {
          "placeholder": "41.85",
          "type": "number",
          "step": "any",
          "min": "-90",
          "max": "90"
        }
      },
      {
        "type": "input",
        "messageKey": "CustomLon",
        "label": "Custom Longitude",
        "defaultValue": "",
        "description": "Decimal degrees, -180 to 180, e.g. -87.65",
        "attributes": {
          "placeholder": "-87.65",
          "type": "number",
          "step": "any",
          "min": "-180",
          "max": "180"
        }
      }
    ]
  },
  {
    "type": "submit",
    "defaultValue": "Save"
  }
]
